{
	"hooks": {
		"SessionStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "bun \"${CLAUDE_PLUGIN_ROOT}/hooks/session.ts\"",
						"timeout": 20
					}
				]
			}
		],
		"UserPromptSubmit": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "bun \"${CLAUDE_PLUGIN_ROOT}/hooks/uplift.ts\"",
						"timeout": 86400,
						"statusMessage": "Prompt Uplift · Graph of Thought"
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "AskUserQuestion",
				"hooks": [
					{
						"type": "command",
						"command": "bun \"${CLAUDE_PLUGIN_ROOT}/hooks/answers.ts\"",
						"timeout": 30
					}
				]
			},
			{
				"matcher": "mcp__(plugin_all-in-one_)?aio__github_create_pull_request",
				"hooks": [
					{
						"type": "command",
						"command": "bun \"${CLAUDE_PLUGIN_ROOT}/hooks/notion-pr-created.ts\"",
						"timeout": 30
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "bun \"${CLAUDE_PLUGIN_ROOT}/hooks/stop.ts\"",
						"timeout": 60
					}
				]
			}
		]
	}
}
